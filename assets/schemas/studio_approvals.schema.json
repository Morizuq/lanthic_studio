{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioApprovals",
  "type": "object",
  "required": ["schema_version", "approvals"],
  "properties": {
    "schema_version": { "type": "string" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "status"],
        "properties": {
          "scene_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "needs_regen"]
          },
          "selected_version": { "type": "integer" },
          "prompt_override": { "type": "string" },
          "review_notes": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
